<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/check"
            android:text="① 一键体检（10 秒出结论）"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/verdict"
            android:text="点「一键体检」：测你到路由器(第一跳)、到外网，分清是信号问题还是带宽问题。\n\n「扫描周边 WiFi」：看邻居都占了哪个信道。"
            android:padding="12dp"
            android:textSize="13sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/scan"
            android:text="② 扫描周边 WiFi（看信道拥堵）"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="下面四个能直接动手改："
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRouter"
            android:text="🔧 打开路由器后台（改信道/限速）"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnDns"
            android:text="⚡ 换私有 DNS（治「网页转圈圈」）"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnCopy"
            android:text="📋 复制体检报告"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnWifiSet"
            android:text="📶 打开 WiFi 设置（换 5G 频段）"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnBattery"
            android:text="🔋 关掉电池限制（防 Wi-Fi 被休眠）"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvTip"
            android:text="提示：路由器后台地址就是「体检」里显示的第一跳 IP，密码多半在路由器背面。"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="300dp" />
    </LinearLayout>
</ScrollView>
